---
import '../styles/global.css';
import Navbar from '../components/astro/Navbar.astro';
import Footer from '../components/astro/Footer.astro';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="id" class="bg-secondary text-primary antialiased selection:bg-accent selection:text-primary scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
		<title>Daryas Tech | Web Development Services</title>
    <ClientRouter />
	</head>
	<body class="font-sans flex flex-col min-h-screen">
		<Navbar />
		<main class="flex-grow pt-20">
			<slot />
		</main>
		<Footer />
	</body>
</html>
